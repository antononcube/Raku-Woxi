use Test;
#use lib 'lib';
use Woxi;
my $fixture = 't/fixtures/woxi'.IO.absolute.Str;
my $answer = woxi-eval('1 + 2', :executable($fixture));
is $answer.stdout, "3\n", 'captures Woxi standard output';
is $answer.stderr, '', 'captures no standard error on success';
is $answer.exitcode, 0, 'records a successful exit status';
is $answer.Str, '3', 'stringifies to trimmed standard output';
is $answer.source, '1 + 2', 'records the expression';
ok $answer.success, 'successful result is marked successful';
is evaluate('1 + 2', :executable($fixture)).stdout, "3\n", 'evaluate is an alias';
my $failure = woxi-eval('bad', :executable($fixture));
is $failure.exitcode, 7, 'records a non-zero exit status';
is $failure.stderr, "parse error\n", 'captures standard error';
throws-like { $failure.throw-on-error }, Woxi::CommandFailed, 'can promote a non-zero status to an exception';
my $run = woxi-run('example.wls', :executable($fixture));
is $run.stdout, "ran: example.wls\n", 'runs a Woxi script';
ok woxi-available(:executable($fixture)), 'detects an available executable';
ok !woxi-available(:executable('definitely-no-woxi-executable')), 'reports a missing executable';
throws-like { woxi-eval('sleep', :executable($fixture), :timeout(.05)) }, Woxi::Timeout, 'enforces an execution timeout';
done-testing;
